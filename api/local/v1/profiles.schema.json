{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["profiles", "page"],
  "properties": {
    "profiles": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["profileId", "name", "endpoint", "region", "bucket", "prefix", "secretRef", "enabled", "qualificationState"],
        "properties": {
          "profileId": {"$ref": "common.schema.json#/$defs/id"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "endpoint": {"type": "string", "format": "uri", "maxLength": 2048},
          "region": {"type": "string", "minLength": 1, "maxLength": 128},
          "bucket": {"type": "string", "minLength": 3, "maxLength": 255},
          "prefix": {"type": "string", "maxLength": 768},
          "secretRef": {"type": "string", "minLength": 1, "maxLength": 512},
          "enabled": {"type": "boolean"},
          "qualificationState": {"enum": ["unprobed", "qualified", "failed", "expired"]}
        },
        "additionalProperties": false
      }
    },
    "page": {"$ref": "common.schema.json#/$defs/page"}
  },
  "additionalProperties": false
}
