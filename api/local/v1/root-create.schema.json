{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["profileId", "canonicalPath", "mode"],
  "properties": {
    "profileId": {"$ref": "common.schema.json#/$defs/id"},
    "canonicalPath": {"type": "string", "minLength": 3, "maxLength": 4096, "pattern": "^(?:/|[A-Za-z]:\\\\).+"},
    "mode": {"enum": ["two-way", "upload-only", "download-only"]}
  },
  "additionalProperties": false
}
