{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "formatVersion", "rootId", "logicalPath", "logicalPathHash", "priorManifestRevisionId", "revision", "deletedAt", "retainUntil"],
  "properties": {
    "protocol": {"const": "sluice.remote"},
    "formatVersion": {"const": 1},
    "rootId": {"$ref": "common.schema.json#/$defs/id"},
    "logicalPath": {"$ref": "common.schema.json#/$defs/logicalPath"},
    "logicalPathHash": {"$ref": "common.schema.json#/$defs/sha256"},
    "priorManifestRevisionId": {"$ref": "common.schema.json#/$defs/id"},
    "priorContentHash": {"$ref": "common.schema.json#/$defs/sha256"},
    "revision": {"$ref": "common.schema.json#/$defs/revision"},
    "deletedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "retainUntil": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "additionalProperties": false
}
